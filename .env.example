# Site Configuration
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Email Configuration (Choose one option)

# Option 1: Gmail SMTP (Recommended for Development)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
GMAIL_TO=your-email@gmail.com

# Option 2: Custom SMTP Server (Production)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-username
SMTP_PASSWORD=your-password

# Common SMTP Examples:
# SendGrid: smtp.sendgrid.net:587
# Mailgun: smtp.mailgun.org:587
# Office 365: smtp.office365.com:587
# Yahoo: smtp.mail.yahoo.com:587

# ---------------------------------------------------------------------------
# Project submission & certificates (see CERTIFICATES.md)
# ---------------------------------------------------------------------------
# REQUIRED in production: random string, 32+ chars (signs the login session cookie)
SESSION_SECRET=
# Public origin written into certificate QR codes, e.g. https://lms.cloudinstitution.com
NEXT_PUBLIC_SITE_URL=
# Storage bucket for project files (defaults to NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET)
FIREBASE_STORAGE_BUCKET=
# Certificate branding (defaults shown)
CERT_ORG_NAME=Cloud Institution
CERT_SIGNATORY_NAME=Dilip D
CERT_SIGNATORY_TITLE=CEO
CERT_TIMEZONE=Asia/Kolkata
# Privacy: let anyone with the verify link download the PDF (default false)
CERT_PUBLIC_DOWNLOAD=false
# Privacy: verify page accepts only the random QR token, not the (guessable) student ID (default false)
CERT_VERIFY_TOKEN_ONLY=false
